{
  "name": "superset-plugin-chart-inline-filter",
  "version": "0.1.0",
  "description": "Superset viz plugin that renders native dashboard filters inline above a chart",
  "keywords": [
    "superset",
    "superset-viz-plugin",
    "filter",
    "inline",
    "dashboard"
  ],
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "files": [
    "lib",
    "esm",
    "src"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc --outDir lib --module commonjs",
    "build:esm": "tsc --outDir esm --module esnext",
    "dev": "webpack --config webpack.config.js --watch",
    "bundle": "webpack --config webpack.config.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@superset-ui/core": "*",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@superset-ui/chart-controls": ">=0.19.0",
    "@superset-ui/core": ">=0.19.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "typescript": "^4.9.5",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0",
    "ts-loader": "^9.0.0"
  },
  "dependencies": {
    "@emotion/css": "^11.0.0",
    "antd": "^4.24.0"
  }
}
